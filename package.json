{
  "name": "prospectai",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --use-env-proxy --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --import tsx server/index.ts",
    "test": "node --use-env-proxy --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup-env.mjs",
    "check:connections": "node --use-env-proxy --import tsx scripts/check-connections.ts",
    "build:vercel": "npm run build && node scripts/prepare-vercel.mjs",
    "predev": "node scripts/check-runtime.mjs",
    "prestart": "node scripts/check-runtime.mjs",
    "prebuild": "node scripts/check-runtime.mjs",
    "precheck:connections": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.1.0",
    "cheerio": "^1.1.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "imapflow": "2.9.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "nodemailer": "10.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "9.3.12",
    "saxes": "6.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "yauzl": "3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "fflate": "0.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "write-excel-file": "4.1.1"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
