# Local : npm run setup crée .env et les secrets de l’espace sans les afficher.
PORT=3001
APP_URL=http://localhost:5173
APP_PASSWORD=
DATA_ENCRYPTION_KEY=
DATA_DIR=.data

# Facultatif : collecte Google Maps payante, déclenchée uniquement par votre clic.
APIFY_TOKEN=

# Facultatif : seconde qualification explicite des leads avec Gemma via OpenRouter.
# Modèle fixé à google/gemma-4-26b-a4b-it:free ; aucun repli payant.
# La clé peut aussi être enregistrée chiffrée dans les paramètres de l’application.
OPENROUTER_API_KEY=

# Facultatif : hébergement de ProspectAI sur Vercel avec stockage durable Turso.
# Laisser vide pour conserver SQLite en local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Aucun compte Gmail, accès de publication ou clé API de rédaction n’est utilisé.

# Facultatif : API machine Hermès connectée, désactivée si vide/faible.
# Secret dédié aléatoire : Python secrets.token_urlsafe(32). Ne pas réutiliser APP_PASSWORD.
# APP_PASSWORD >=16 caractères reste obligatoire côté app, jamais transmis à Hermès.
# Conserver DATA_DIR/TURSO_* pour réutiliser l’historique existant ; voir docs/HERMES-AGENT.md.
PROSPECTIA_AGENT_TOKEN=
